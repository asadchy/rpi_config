#!/bin/sh -e

/home/pi/hostname.sh &

/etc/gpio/gpio.sh &

sleep 1

#/etc/gsm/gsm_modem.sh &

/home/pi/ioctl -m 0 &
/home/pi/ioctl -s 1 &

/bin/echo -e -n "\xFF\x00\x00\x00" > /dev/in-pi556

/bin/echo 1 > /dev/gpio/LCD_LED

/usr/bin/dtoverlay w1-gpio gpiopin=29
/usr/bin/dtoverlay w1-gpio gpiopin=42

ln -sf `ls /sys/devices/w1_bus_master1/28-*/w1_temperature` /home/pi/w1_temperature1 &
ln -sf `ls /sys/devices/w1_bus_master2/28-*/w1_temperature` /home/pi/w1_temperature2 &

ln -sf `ls /sys/devices/platform/soc/*/i2c-0/0-0040/hwmon/hwmon*/current_monitor` /home/pi/doorlock_current_monitor &
ln -sf `ls /sys/devices/platform/soc/*/i2c-0/0-0040/hwmon/hwmon*/voltage_monitor` /home/pi/doorlock_voltage_monitor &

ln -sf `ls /sys/devices/platform/soc/*/i2c-0/0-0041/hwmon/hwmon*/current_monitor` /home/pi/panel_current_monitor &
ln -sf `ls /sys/devices/platform/soc/*/i2c-0/0-0041/hwmon/hwmon*/voltage_monitor` /home/pi/panel_voltage_monitor &

/home/pi/expand.sh &

sleep 5

exit 0
